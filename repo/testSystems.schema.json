{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    }
  },
  "patternProperties": {
    "^[A-Za-z0-9_]+$": {
      "type": "object",
      "properties": {
        "includeProjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeProjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "includeFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
